# Uso LOCAL com docker compose. Copie para .env. NUNCA commite o .env real.
# No Azure, estas configuracoes ficam em "App Service > Variaveis de ambiente".
COMPOSE_PROJECT_NAME=reciclagem-dev
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
SWAGGER_ENABLED=true

# Chave JWT (gere com: openssl rand -hex 32). Minimo 32 caracteres.
JWT_KEY=TROQUE_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
