{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaginacaoViewModel<PontoColetaViewModel>",
  "type": "object",
  "required": ["itens", "pagina", "tamanho", "totalItens", "totalPaginas"],
  "properties": {
    "itens": {
      "type": "array",
      "items": { "$ref": "#/definitions/ponto" }
    },
    "pagina": { "type": "integer", "minimum": 1 },
    "tamanho": { "type": "integer", "minimum": 1 },
    "totalItens": { "type": "integer", "minimum": 0 },
    "totalPaginas": { "type": "integer", "minimum": 0 }
  },
  "definitions": {
    "ponto": {
      "type": "object",
      "required": ["pontoColetaId", "nome", "endereco", "bairro", "capacidadeMaximaKg", "cargaAtualKg", "ativo"],
      "properties": {
        "pontoColetaId": { "type": "integer" },
        "nome": { "type": "string" },
        "endereco": { "type": "string" },
        "bairro": { "type": "string" },
        "capacidadeMaximaKg": { "type": "number" },
        "cargaAtualKg": { "type": "number" },
        "ativo": { "type": "boolean" }
      }
    }
  }
}
